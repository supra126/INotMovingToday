# ============ AI Analysis (Gemini) ============
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini thinking level (optional): low | medium | high
# Default: model default (medium). "low" is faster and cheaper.
# GEMINI_THINKING_LEVEL=medium

# ============ Video Generation ============
# Provider: mock (default for testing) or omni (Google Gemini Omni Flash)
# Omni uses the same GEMINI_API_KEY above.
# Each clip is 3-10 s; longer videos are extended in segments up to 40 s.
VIDEO_PROVIDER=mock

# ============ Build Mode ============
# Set to "static" for static export build
# NEXT_PUBLIC_BUILD_MODE=static
